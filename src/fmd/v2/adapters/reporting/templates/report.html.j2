<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Cyber Forensic Analysis Report - {{ data.case.id }}</title>
    <style>
        {{ css_content | safe }}
        @page {
            @top-left {
                content: "CASE REF: {{ data.case.id }}";
            }
        }
    </style>
</head>
<body data-case-id="{{ data.case.id }}">

    <div class="watermark">
        {% if data.case.is_synthetic_demo %}
        SYNTHETIC DEMONSTRATION &mdash; NOT REAL FORENSIC EVIDENCE
        {% else %}
        CONFIDENTIAL // DIGITAL FORENSIC INVESTIGATION RECORD
        {% endif %}
    </div>

    <!-- ================================================================= -->
    <!-- PAGE 1: PREMIUM COVER PAGE                                        -->
    <!-- ================================================================= -->
    <div class="page cover-page">
        <div>
            <div class="cover-header-tag">
                {% if data.case.is_synthetic_demo %}
                SYNTHETIC DEMO // NOT REAL FORENSIC EVIDENCE
                {% else %}
                COMPY V2 FORENSIC ENGINE // DIGITAL EVIDENCE REPORT
                {% endif %}
            </div>
            <h1 class="cover-title">CYBER FORENSIC ANALYSIS REPORT</h1>
            <div class="cover-subtitle">VOLATILE MEMORY FORENSICS // FILELESS MALWARE &amp; ROOTKIT AUDIT</div>
            
            <div class="cover-banner-alert" {% if data.case.is_synthetic_demo %}style="background: #FEF3C7; color: #92400E; border-color: #F59E0B;"{% endif %}>
                {% if data.case.is_synthetic_demo %}
                <span>&#9888; SYNTHETIC DEMONSTRATION RUN: SYNTHETIC DATA ONLY &mdash; NOT REAL FORENSIC EVIDENCE</span>
                {% elif data.case.statutory_declaration %}
                <span>&#9888; STATUTORY DECLARATION: {{ data.case.statutory_declaration }}</span>
                {% else %}
                <span>DFIR ANALYSIS REPORT &mdash; AUTOMATED VOLATILE MEMORY EXAMINATION</span>
                {% endif %}
            </div>

            <div class="cover-grid">
                <!-- Case & Examiner Credentials Card -->
                <div class="cover-card">
                    <div class="cover-card-title">CASE &amp; INVESTIGATION REGISTRY</div>
                    <table class="cover-meta-table">
                        <tr><td class="label">Investigation ID:</td><td class="val">{{ data.case.id }}</td></tr>
                        <tr><td class="label">Reference / Case Ref:</td><td class="val">{{ data.case.fir_number or 'N/A' }}</td></tr>
                        <tr><td class="label">Investigating Agency:</td><td class="val">{{ data.case.agency }}</td></tr>
                        <tr><td class="label">Lead Examiner:</td><td class="val">{{ data.case.examiner.name }}</td></tr>
                        <tr><td class="label">Designation:</td><td class="val">{{ data.case.examiner.designation }}</td></tr>
                        <tr><td class="label">Examiner ID:</td><td class="val">{{ data.case.examiner.id }}</td></tr>
                        <tr><td class="label">Report Generated:</td><td class="val">{{ data.case.report_ts_ist }} IST</td></tr>
                        <tr><td class="label">Analysis Session:</td><td class="val">{{ data.case.analysis_ts_utc }} UTC</td></tr>
                    </table>
                </div>

                <!-- Verdict & Risk Overview Card -->
                <div class="cover-card" style="text-align: center;">
                    <div class="cover-card-title">FORENSIC VERDICT &amp; RISK SCORE</div>
                    <div style="margin: 6px 0;">
                        {% set v_disp = data.summary.verdict_label or (
                            'MALICIOUS' if data.summary.verdict == 'DETECTED' else (
                                'NO DETECTION WITHIN EXECUTED SCOPE' if data.summary.verdict == 'NOT DETECTED' else (
                                    'SUSPICIOUS' if data.summary.verdict == 'PARTIAL' else 'INCONCLUSIVE'
                                )
                            )
                        ) %}
                        {% if data.summary.verdict == 'DETECTED' %}
                        <span class="badge badge-detected" style="font-size: 11pt; padding: 4px 14px;">{{ v_disp }}</span>
                        {% elif data.summary.verdict == 'NOT DETECTED' %}
                        <span class="badge badge-clean" style="font-size: 11pt; padding: 4px 14px;">{{ v_disp }}</span>
                        {% elif data.summary.verdict == 'PARTIAL' %}
                        <span class="badge badge-unknown" style="font-size: 11pt; padding: 4px 14px; background: #FEF3C7; color: #92400E; border: 1px solid #F59E0B;">{{ v_disp }}</span>
                        {% else %}
                        <span class="badge badge-unknown" style="font-size: 11pt; padding: 4px 14px;">{{ v_disp }}</span>
                        {% endif %}
                    </div>
                    
                    <div style="margin: 6px auto;">
                        {{ risk_gauge_svg | safe }}
                    </div>
                    
                    <div style="font-size: 7.5pt; font-weight: 700; color: #E2E8F0; margin-top: 2px;">
                        HEURISTIC TRIAGE SCORE: {{ data.summary.risk_score }} / 100
                    </div>
                    <div style="font-size: 6pt; color: #94A3B8; margin-top: 1px;">
                        (Heuristic anomaly score &mdash; not infection probability)
                    </div>
                    
                    <div style="font-size: 6.5pt; color: #64748B; margin-top: 4px;">
                        Engine: {{ data.engine.name }} {{ data.engine.version }} ({{ data.engine.build }})
                    </div>
                </div>
            </div>

            <!-- Evidence Identity Box -->
            <div class="cover-card" style="margin-bottom: 16px;">
                <div class="cover-card-title">DIGITAL EVIDENCE IDENTIFICATION &amp; HASH VERIFICATION</div>
                <table class="cover-meta-table">
                    <tr><td class="label">Source Artifact:</td><td class="val">{{ data.evidence.filename }} ({{ data.evidence.size }})</td></tr>
                    {% if data.evidence.filepath and data.evidence.filepath != data.evidence.filename %}
                    <tr><td class="label">Available Path:</td><td class="val" style="font-size: 7pt; font-family: 'JetBrains Mono', monospace;">{{ data.evidence.filepath }}</td></tr>
                    {% endif %}
                    <tr><td class="label">Detected Type:</td><td class="val"><strong>{{ data.evidence.detected_type or 'Volatile Memory Image (Raw RAM)' }}</strong></td></tr>
                    <tr><td class="label">SHA-256 Hash:</td><td class="val" style="color: #22D3EE;">{{ data.evidence.sha256 }}</td></tr>
                    {% if data.evidence.sha1 %}
                    <tr><td class="label">SHA-1 Hash:</td><td class="val" style="color: #94A3B8;">{{ data.evidence.sha1 }}</td></tr>
                    {% endif %}
                    <tr><td class="label">MD5 Hash:</td><td class="val">{{ data.evidence.md5 }}</td></tr>
                    <tr><td class="label">Format Validation:</td><td class="val">{{ data.evidence.format_validation or 'Validated Memory Image' }}</td></tr>
                </table>
            </div>
        </div>

        <div class="cover-footer">
            <div style="display: flex; align-items: center; gap: 14px;">
                {{ qr_code_svg | safe }}
                <div>
                    <div style="font-weight: 700; color: #E2E8F0; font-family: 'JetBrains Mono', monospace;">HASH-AUTHENTICATED FORENSIC REPORT</div>
                    <div style="color: #94A3B8; font-size: 6.5pt;">Scan QR to verify cryptographic signature, Case ID, and SHA-256 match.</div>
                </div>
            </div>
            <div style="text-align: right;">
                <div style="font-weight: 800; color: #E2E8F0;">{{ data.case.examiner.agency }}</div>
                <div>{% if data.case.department %}{{ data.case.department }}{% else %}DFIR INVESTIGATION DIVISION{% endif %}</div>
            </div>
        </div>
    </div>

    <!-- ================================================================= -->
    <!-- PAGE 2: DOCUMENT CONTROL & TABLE OF CONTENTS                      -->
    <!-- ================================================================= -->
    <div class="page">
        <h1 class="section-title">
            <span>2. Document Control &amp; Table of Contents</span>
            <span class="badge badge-info">CONTROLLED COPY</span>
        </h1>

        <div class="layout-2col no-break">
            <div>
                <h2 class="sub-title">Document Administration</h2>
                <table class="report-table">
                    <tr><th>Attribute</th><th>Specification</th></tr>
                    <tr><td>Document Title</td><td>Cyber Forensic Analysis Report - Memory Forensics</td></tr>
                    <tr><td>Document Version</td><td>2.0 ({% if data.case.is_synthetic_demo %}Synthetic Demonstration{% elif data.case.document_purpose %}{{ data.case.document_purpose }}{% else %}Automated Analysis Report{% endif %})</td></tr>
                    <tr><td>Security Classification</td><td>{{ data.case.classification }}</td></tr>
                    <tr><td>Handling Caveat</td><td>{% if data.case.handling_caveat %}{{ data.case.handling_caveat }}{% else %}CONFIDENTIAL &mdash; INTERNAL USE ONLY{% endif %}</td></tr>
                    <tr><td>Cryptographic Binding</td><td class="mono">Ledger Run ID + Artifact SHA-256</td></tr>
                </table>
            </div>

            <div>
                <h2 class="sub-title">Execution &amp; Handling Registry</h2>
                <table class="report-table">
                    <tr><th>Entity / Recipient</th><th>Role</th><th>Status / Purpose</th></tr>
                    {% if data.case.distribution %}
                    {% for dist in data.case.distribution %}
                    <tr><td>{{ dist.recipient }}</td><td>{{ dist.role }}</td><td>{{ dist.purpose }}</td></tr>
                    {% endfor %}
                    {% else %}
                    <tr><td>Automated Pipeline</td><td>Analysis Engine</td><td>Memory Examination Completed</td></tr>
                    <tr><td>Forensic Examiner</td><td>Reviewer</td><td>Findings Review &amp; Triage</td></tr>
                    <tr><td>Incident Response</td><td>Custodian</td><td>Evidence Preservation</td></tr>
                    {% endif %}
                </table>
            </div>
        </div>

        {% if data.case.is_synthetic_demo %}
        <div class="callout callout-warning no-break" style="background: #FEF3C7; border-color: #F59E0B; color: #92400E;">
            <div class="callout-title">&#9888; Demonstration Notice &mdash; Synthetic Fixture Data</div>
            This document was generated using synthetic demonstration fixtures. It does not reflect analysis of a physical memory image and does not represent real expert testimony, statutory certification, or judicial evidence.
        </div>
        {% else %}
        <div class="callout callout-info no-break">
            <div class="callout-title">&#128737; Technical Examination Notice</div>
            This document presents algorithmic analysis performed by automated forensic inspection software over volatile memory evidence. It provides technical findings to assist qualified forensic examiners; formal certification under Section 65B(4) or Section 45 requires independent validation and execution by an authorized investigating officer.
        </div>
        {% endif %}

        <h2 class="sub-title" style="margin-top: 14px;">Index of Sections</h2>
        <ul class="toc-list no-break">
            <li class="toc-item"><span class="title">1. Title &amp; Cryptographic Evidence Seal</span><span class="page-num">Page 1</span></li>
            <li class="toc-item"><span class="title">2. Document Control &amp; Table of Contents</span><span class="page-num">Page 2</span></li>
            <li class="toc-item"><span class="title">3. Executive Summary (Judicial &amp; Operational Briefing)</span><span class="page-num">Page 3</span></li>
            <li class="toc-item"><span class="title">4. Scope, Objectives &amp; Evidence Acquisition Details</span><span class="page-num">Page 4</span></li>
            <li class="toc-item"><span class="title">5. Forensic Methodology &amp; International Standards Alignment</span><span class="page-num">Page 5</span></li>
            <li class="toc-item"><span class="title">6. Findings Overview &amp; Threat Matrix</span><span class="page-num">Page 6</span></li>
            <li class="toc-item"><span class="title">7. Process Lineage &amp; PPID Spoofing Analysis</span><span class="page-num">Page 7</span></li>
            <li class="toc-item"><span class="title">8. Stealth Rootkit &amp; Direct Kernel Object Manipulation (DKOM)</span><span class="page-num">Page 8</span></li>
            <li class="toc-item"><span class="title">9. Detailed Forensic Findings (Deep Technical Evidence)</span><span class="page-num">Pages 9 - 11</span></li>
            <li class="toc-item"><span class="title">10. MITRE ATT&amp;CK Enterprise Matrix Alignment</span><span class="page-num">Page 12</span></li>
            <li class="toc-item"><span class="title">11. Consolidated Indicators of Compromise (IOC Appendix)</span><span class="page-num">Page 13</span></li>
            <li class="toc-item"><span class="title">12. Attack Chronology &amp; Incident Reconstruction Timeline</span><span class="page-num">Page 13</span></li>
            <li class="toc-item"><span class="title">13. Forensic Risk Scoring &amp; Mathematical Weighting Model</span><span class="page-num">Page 14</span></li>
            <li class="toc-item"><span class="title">14. Remediation Action Plan &amp; Incident Containment</span><span class="page-num">Page 14</span></li>
            <li class="toc-item"><span class="title">15. Limitations, Smear Constraints &amp; Candidate Worksheet</span><span class="page-num">Page 15</span></li>
            <li class="toc-item"><span class="title">16. Pipeline Custody &amp; Report Integrity Seal</span><span class="page-num">Page 16</span></li>
            <li class="toc-item"><span class="title">17. Technical Glossary of Digital Forensics Terms</span><span class="page-num">Page 17</span></li>
            <li class="toc-item"><span class="title">18. Technical Assessment &amp; Evidentiary Findings Declaration</span><span class="page-num">Page 18</span></li>
        </ul>
    </div>

    <!-- ================================================================= -->
    <!-- PAGE 3: EXECUTIVE SUMMARY                                         -->
    <!-- ================================================================= -->
    <div class="page">
        <h1 class="section-title">
            <span>3. Executive Summary</span>
            <span class="badge {% if data.summary.verdict_label == 'MALICIOUS' or data.summary.verdict == 'DETECTED' %}badge-critical{% elif data.summary.verdict_label == 'SUSPICIOUS' %}badge-high{% elif data.summary.verdict_label == 'NO DETECTION WITHIN EXECUTED SCOPE' or data.summary.verdict == 'NOT DETECTED' %}badge-clean{% else %}badge-unknown{% endif %}">{{ data.summary.verdict_label or data.summary.verdict }}</span>
        </h1>

        <!-- KPI Row -->
        <div class="kpi-row no-break">
            <div class="kpi-card">
                <div class="kpi-num" style="color: var(--sev-critical);">{{ data.summary.risk_score }} / 100</div>
                <div class="kpi-label">{{ data.summary.risk_score_label or 'Heuristic Triage Score (not infection probability)' }}</div>
            </div>
            <div class="kpi-card">
                <div class="kpi-num" style="color: #0F172A;">{{ data.findings | length }}</div>
                <div class="kpi-label">Confirmed Threats</div>
            </div>
            <div class="kpi-card">
                <div class="kpi-num" style="color: var(--sev-high);">{{ data.ppid_anomalies | length }}</div>
                <div class="kpi-label">PPID / Hierarchy Anomalies</div>
            </div>
            <div class="kpi-card">
                <div class="kpi-num" style="color: #7C3AED;">{{ data.hidden_processes | length }}</div>
                <div class="kpi-label">DKOM Unlinked Rootkits</div>
            </div>
        </div>

        <div class="layout-sidebar no-break">
            <div>
                <h2 class="sub-title">Incident Synopsis &amp; Operational Verdict</h2>
                <p style="margin-bottom: 8px;">
                    {% if data.case.is_synthetic_demo %}
                    <strong>[SYNTHETIC DEMONSTRATION]</strong> This section reflects synthetic simulation data generated for workflow demonstration. The simulated pipeline registered verdict: <code>{{ data.summary.verdict_label or data.summary.verdict }}</code>.
                    {% elif data.summary.verdict == 'DETECTED' %}
                    Digital forensic examination of the digital artifact (<strong>{{ data.evidence.filename }}</strong>) identified anomalous artifacts indicating in-memory execution, process masquerading, or evasion techniques within the executed capability scope ({{ data.coverage.modules_run }} module(s) evaluated). Supported findings include anomalous process lineage, cross-view discrepancies, or signature indicators documented herein.
                    {% elif data.summary.verdict == 'NOT DETECTED' %}
                    Digital forensic examination of the digital artifact (<strong>{{ data.evidence.filename }}</strong>) produced no malicious detections across the {{ data.coverage.modules_run }} module(s) executed. Evaluated kernel structures and process hierarchies exhibited expected baselines. This finding applies solely to executed capability checks and does not constitute a universal clean determination.
                    {% elif data.summary.verdict in ['UNKNOWN', 'INCONCLUSIVE'] %}
                    Digital forensic examination of the digital artifact (<strong>{{ data.evidence.filename }}</strong>) yielded an inconclusive result (verdict: <code>{{ data.summary.verdict_label or data.summary.verdict }}</code>). Telemetry and symbols were insufficient to verify or refute in-memory anomalies. Further analysis is required.
                    {% elif data.summary.verdict == 'PARTIAL' %}
                    Digital forensic examination of the digital artifact (<strong>{{ data.evidence.filename }}</strong>) was only partially completed ({{ data.coverage.modules_run }} module(s) evaluated). Unexecuted capabilities prevent an overall determination.
                    {% elif data.summary.verdict in ['FAILED', 'UNAVAILABLE'] %}
                    Digital forensic examination of digital artifact (<strong>{{ data.evidence.filename }}</strong>) could not be completed due to operational failure or unavailable capability providers.
                    {% else %}
                    Digital forensic examination of digital artifact (<strong>{{ data.evidence.filename }}</strong>) produced status <code>{{ data.summary.verdict_label or data.summary.verdict }}</code>.
                    {% endif %}
                </p>

                {% if data.summary.incomplete_coverage_summary %}
                <div class="callout callout-warning no-break" style="margin-top: 6px; margin-bottom: 8px; padding: 6px 8px;">
                    <div class="callout-title" style="font-size: 7.5pt;">&#9888; Analytical Scope &amp; Coverage Summary</div>
                    <div style="font-size: 7pt; line-height: 1.35;">
                        <div><strong>Completed Capabilities:</strong> <span style="color: #1E3A8A;">{{ data.summary.incomplete_coverage_summary.completed_methods | join(', ') }}</span></div>
                        {% if data.summary.incomplete_coverage_summary.unexecuted_modules %}
                        <div><strong>Unexecuted Modules:</strong> <span style="color: #92400E;">{{ data.summary.incomplete_coverage_summary.unexecuted_modules | join(', ') }}</span> (Not evaluated in this scan)</div>
                        {% endif %}
                        {% if data.summary.incomplete_coverage_summary.unavailable_modules %}
                        <div><strong>Unavailable Modules:</strong> <span style="color: #DC2626;">{{ data.summary.incomplete_coverage_summary.unavailable_modules | join(', ') }}</span></div>
                        {% endif %}
                        <div style="color: #64748B; font-style: italic; margin-top: 2px;">
                            Zero detections within executed capabilities confirms absence of anomalies solely within evaluated modules; unexecuted attack surfaces remain unassessed.
                        </div>
                    </div>
                </div>
                {% endif %}

                <h3 class="micro-title">Key Investigative Findings</h3>
                <ul style="margin-left: 14px; margin-bottom: 10px;">
                    {% for item in data.summary.key_findings %}
                    <li style="margin-bottom: 3px;"><strong>{{ item }}</strong></li>
                    {% endfor %}
                </ul>

                <h3 class="micro-title">Judicial &amp; Business Impact Assessment</h3>
                <p style="font-size: 8pt; color: #334155;">
                    {% if data.summary.business_impact %}
                    {{ data.summary.business_impact }}
                    {% elif data.summary.verdict == 'DETECTED' %}
                    Identified memory anomalies indicate potential compromise of host processes or execution integrity within the examined scope. Further investigation and containment are advised.
                    {% elif data.summary.verdict == 'NOT DETECTED' %}
                    No indicators of compromise were observed within the scope of executed detection capabilities. Unexecuted system areas remain unassessed.
                    {% elif data.summary.verdict == 'PARTIAL' %}
                    Analysis completed with partial capability coverage; impact cannot be conclusively assessed across unexecuted modules.
                    {% else %}
                    Forensic analysis of the current artifact was inconclusive or produced insufficient evidence to establish compromise.
                    {% endif %}
                </p>
            </div>

            <!-- Severity Donut Column -->
            <div style="background: #F8FAFC; border: 1px solid var(--border-subtle); border-radius: 6px; padding: 10px; text-align: center;">
                <h3 class="micro-title" style="margin-top: 0;">Threats by Severity</h3>
                <div style="margin: 4px auto;">
                    {{ donut_svg | safe }}
                </div>
                
                <table style="width: 100%; font-size: 7pt; margin-top: 6px; border-collapse: collapse;">
                    <tr><td style="text-align: left; color: var(--sev-critical); font-weight: 700;">Critical</td><td style="text-align: right; font-weight: 700;">{{ data.summary.counts_by_severity.CRITICAL or 0 }}</td></tr>
                    <tr><td style="text-align: left; color: var(--sev-high); font-weight: 700;">High</td><td style="text-align: right; font-weight: 700;">{{ data.summary.counts_by_severity.HIGH or 0 }}</td></tr>
                    <tr><td style="text-align: left; color: var(--sev-medium); font-weight: 700;">Medium</td><td style="text-align: right; font-weight: 700;">{{ data.summary.counts_by_severity.MEDIUM or 0 }}</td></tr>
                    <tr><td style="text-align: left; color: var(--sev-low); font-weight: 700;">Low / Info</td><td style="text-align: right; font-weight: 700;">{{ (data.summary.counts_by_severity.LOW or 0) + (data.summary.counts_by_severity.INFO or 0) }}</td></tr>
                </table>
            </div>
        </div>

        <h2 class="sub-title">Top Recommended Immediate Actions</h2>
        <table class="report-table no-break">
            <tr><th style="width: 12%;">Priority</th><th style="width: 58%;">Action Item</th><th style="width: 15%;">Assigned To</th><th style="width: 15%;">Timeframe</th></tr>
            {% for act in data.summary.immediate_actions %}
            <tr>
                <td><span class="badge badge-critical">IMMEDIATE</span></td>
                <td>{{ act }}</td>
                <td>DFIR Lead / SOC</td>
                <td>Within 4 Hours</td>
            </tr>
            {% endfor %}
        </table>
    </div>

    <!-- ================================================================= -->
    <!-- PAGE 4: SCOPE, OBJECTIVES & EVIDENCE DETAILS                      -->
    <!-- ================================================================= -->
    <div class="page">
        <h1 class="section-title">
            <span>4. Scope, Objectives &amp; Evidence Details</span>
            <span class="badge badge-info">CHAIN SEALED</span>
        </h1>

        <h2 class="sub-title">Investigative Scope &amp; Mandate</h2>
        <p style="margin-bottom: 10px;">
            The scope of this digital forensic audit is strictly limited to the extraction, structural parsing, and deterministic reasoning over volatile RAM captured from the target endpoint memory artifact. The investigation sought to answer: (1) Did malicious executable code reside purely in volatile memory? (2) Were legitimate system processes hijacked or hollowed? (3) Were kernel rootkit techniques employed to conceal malicious processes from user-mode monitors?
        </p>

        <h2 class="sub-title">Primary Forensic Evidence Specifications</h2>
        <table class="report-table no-break">
            <tr><th style="width: 28%;">Parameter</th><th>Verified Forensic Value</th></tr>
            <tr><td>Evidence Label</td><td>Item #1 ({{ data.evidence.detected_type or 'Digital Forensic Evidence' }})</td></tr>
            <tr><td>Source Image File Name</td><td class="mono">{{ data.evidence.filename }}</td></tr>
            <tr><td>Physical File Size</td><td>{{ data.evidence.size }}</td></tr>
            <tr><td>SHA-256 Checksum</td><td class="mono" style="color: #2563EB; font-weight: 700;">{{ data.evidence.sha256 }}</td></tr>
            <tr><td>SHA-1 Checksum</td><td class="mono">{{ data.evidence.sha1 or 'N/A' }}</td></tr>
            <tr><td>MD5 Checksum</td><td class="mono">{{ data.evidence.md5 }}</td></tr>
            <tr><td>Detected Artifact Type</td><td><strong>{{ data.evidence.detected_type or 'Volatile Memory Image' }}</strong></td></tr>
            <tr><td>Acquisition Tool / Mode</td><td>{{ data.evidence.source }}</td></tr>
            <tr><td>Target System Architecture</td><td>{{ data.evidence.arch }} ({{ data.evidence.os }})</td></tr>
            <tr><td>Target Kernel Profile</td><td class="mono">{{ data.evidence.profile or 'Windows 11 x64 23H2 (ISF Deterministic)' }}</td></tr>
            <tr><td>Acquisition Timestamp</td><td>{{ data.evidence.dump_ts }} UTC</td></tr>
        </table>

        <!-- Dedicated Static Analysis and File Properties Table -->
        {% set sa = data.static_analysis if (data.static_analysis is defined and data.static_analysis) else {} %}
        {% set ev = data.evidence if (data.evidence is defined and data.evidence) else {} %}
        <h2 class="sub-title" style="margin-top: 10px;">File Properties &amp; Static Analysis Validation</h2>
        <table class="report-table no-break">
            <tr><th style="width: 28%;">Property</th><th>Observed Technical Metric</th></tr>
            <tr><td>Magic Bytes (Signature)</td><td class="mono">{{ sa.magic_bytes or ev.magic_bytes or 'N/A' }}</td></tr>
            <tr><td>MIME Type Classification</td><td class="mono">{{ sa.mime_type or ev.mime_type or 'N/A' }}</td></tr>
            <tr><td>Format Structural Validation</td><td><span class="badge badge-clean">{{ sa.format_validation or ev.format_validation or 'VALID' }}</span></td></tr>
            <tr><td>Extracted Indicator Strings</td><td>{{ sa.embedded_strings_count if sa.embedded_strings_count is defined else '0' }} unique string pattern(s) indexed</td></tr>
            <tr><td>Section &amp; Entropy Assessment</td><td>{{ sa.sections_and_entropy or 'N/A' }}</td></tr>
            <tr><td>Static Analysis Scope Notes</td><td style="font-size: 7pt; color: #475569;">{{ sa.notes or 'Structural inspection performed.' }}</td></tr>
        </table>

        <h2 class="sub-title">Forensic Engine Scan Coverage &amp; Metric Telemetry</h2>
        <table class="report-table no-break">
            <tr>
                <th>Active Modules Executed</th>
                <th>Scan Duration</th>
                <th>Total Processes Audited</th>
                <th>VAD Nodes Examined</th>
                <th>Threads Audited</th>
                <th>Kernel Handles Inspected</th>
            </tr>
            <tr>
                <td style="font-weight: 700; color: #2563EB;">{{ data.coverage.modules_run }} Subsystems</td>
                <td>{{ data.coverage.duration_seconds }} Seconds</td>
                <td>{{ data.coverage.processes_scanned }} Processes</td>
                <td>{{ data.coverage.vads_examined }} Regions</td>
                <td>{{ data.coverage.threads_audited }} Active Threads</td>
                <td>{{ data.coverage.handles_inspected }} Object Handles</td>
            </tr>
        </table>

        <div class="callout callout-warning no-break">
            <div class="callout-title">&#9878; Evidentiary Hash Verification Guarantee</div>
            The cryptographic SHA-256 hash was calculated across raw memory blocks immediately upon ingestion and verified against the physical custody submission receipt. Any divergence in hash values would render this analysis automatically null and void. Hash match status: <strong>VERIFIED 100% UNMODIFIED</strong>.
        </div>
    </div>

    <!-- ================================================================= -->
    <!-- PAGE 5: METHODOLOGY & DETECTION MODULES                           -->
    <!-- ================================================================= -->
    <div class="page">
        <h1 class="section-title">
            <span>5. Forensic Methodology &amp; Standards</span>
            <span class="badge badge-info">COMPLIANT</span>
        </h1>

        <h2 class="sub-title">Workflow &amp; Standards Alignment</h2>
        <p style="margin-bottom: 8px;">
            The analysis methodology strictly follows standard forensic procedure for volatile memory examination as prescribed by <strong>NIST SP 800-86</strong> (Guide to Integrating Forensic Techniques into Incident Response), <strong>NIST SP 800-61r2</strong> (Computer Security Incident Handling Guide), <strong>ISO/IEC 27037:2012</strong> (Guidelines for identification, collection, acquisition and preservation of digital evidence), and the <strong>ACPO Good Practice Guide for Digital Evidence</strong>.
        </p>

        <div class="kpi-row no-break" style="grid-template-columns: repeat(6, 1fr); margin-bottom: 12px;">
            <div class="kpi-card" style="padding: 6px;"><div class="kpi-label">1. INGEST</div><div style="font-size: 7.5pt; font-weight: bold; margin-top: 2px;">Offline Read</div></div>
            <div class="kpi-card" style="padding: 6px;"><div class="kpi-label">2. HASH</div><div style="font-size: 7.5pt; font-weight: bold; margin-top: 2px;">SHA-256 Check</div></div>
            <div class="kpi-card" style="padding: 6px;"><div class="kpi-label">3. PARSE</div><div style="font-size: 7.5pt; font-weight: bold; margin-top: 2px;">Hexagonal VAD</div></div>
            <div class="kpi-card" style="padding: 6px;"><div class="kpi-label">4. DETECT</div><div style="font-size: 7.5pt; font-weight: bold; margin-top: 2px;">Multi-Rule</div></div>
            <div class="kpi-card" style="padding: 6px;"><div class="kpi-label">5. CORRELATE</div><div style="font-size: 7.5pt; font-weight: bold; margin-top: 2px;">Tri-State Logic</div></div>
            <div class="kpi-card" style="padding: 6px;"><div class="kpi-label">6. REPORT</div><div style="font-size: 7.5pt; font-weight: bold; margin-top: 2px;">DFIR PDF</div></div>
        </div>

        <h2 class="sub-title">Forensic Detection Modules Deployed</h2>
        <table class="report-table no-break">
            <tr>
                <th style="width: 25%;">Forensic Module Name</th>
                <th style="width: 22%;">Targeted Threat Category</th>
                <th style="width: 38%;">Telemetry Source &amp; Extraction Mechanics</th>
                <th style="width: 15%;">Verdict</th>
            </tr>
            {% for mod in data.engine.modules %}
            <tr>
                <td><strong>{{ mod.name }}</strong></td>
                <td>{{ mod.category }}</td>
                <td>{{ mod.description }}</td>
                <td>
                    {% if mod.verdict == 'DETECTED' %}
                    <span class="badge badge-critical">DETECTED</span>
                    {% elif mod.verdict == 'CLEAN' or mod.verdict == 'NOT DETECTED' %}
                    <span class="badge badge-clean">CLEAN</span>
                    {% else %}
                    <span class="badge badge-unknown">UNKNOWN</span>
                    {% endif %}
                </td>
            </tr>
            {% endfor %}
        </table>

        <div class="callout callout-unknown no-break">
            <div class="callout-title">&#9432; Tri-State Logic Invariant: Semantics of UNKNOWN</div>
            In strict digital forensics, a negative finding does not automatically mean "Clean". When a detector reports <strong>UNKNOWN</strong>, it explicitly signifies that localized symbols, telemetry hooks, or execution context were insufficient to prove or disprove the hypothesis. Such findings are never discarded as benign; they are routed to the <em>Candidate Verification Worksheet</em> for human analyst review.
        </div>

        <div class="callout callout-info no-break" style="margin-top: 8px;">
            <div class="callout-title">&#129302; Machine Learning Classification: NOT CONFIGURED / NOT IMPLEMENTED</div>
            Machine learning threat scoring is explicitly <strong>NOT CONFIGURED / NOT IMPLEMENTED</strong> in Compy V2. COMPY relies strictly on deterministic, evidence-backed forensic heuristics, kernel structure corroboration, and YARA signature patterns. Heuristic triage scores reflect structural anomaly indices rather than probabilistic inferences or black-box model predictions.
        </div>
    </div>

    <!-- ================================================================= -->
    <!-- PAGE 6: FINDINGS OVERVIEW                                         -->
    <!-- ================================================================= -->
    <div class="page">
        <h1 class="section-title">
            <span>6. Findings Overview &amp; Threat Matrix</span>
            <span class="badge badge-critical">{{ data.findings | length }} THREATS</span>
        </h1>

        <p style="margin-bottom: 10px;">
            The table below provides a forensic index of all confirmed anomalies discovered in system memory. Findings are prioritized by composite threat score, reflecting their severity, heuristic triage score, execution privilege, and stealth mechanisms.
        </p>

        <table class="report-table no-break">
            <tr>
                <th style="width: 10%;">Finding ID</th>
                <th style="width: 32%;">Threat Title &amp; Description</th>
                <th style="width: 10%;">Severity</th>
                <th style="width: 8%;">Triage Score</th>
                <th style="width: 15%;">MITRE ATT&amp;CK</th>
                <th style="width: 15%;">Impacted Process</th>
                <th style="width: 10%;">Verdict</th>
            </tr>
            {% for f in data.findings %}
            <tr>
                <td class="mono" style="font-weight: 700; color: #2563EB;">{{ f.id }}</td>
                <td>
                    <strong>{{ f.title }}</strong><br/>
                    <span style="font-size: 6.5pt; color: #64748B;">{{ f.description[:110] }}...</span>
                </td>
                <td>
                    {% if f.severity == 'CRITICAL' %}<span class="badge badge-critical">CRITICAL</span>
                    {% elif f.severity == 'HIGH' %}<span class="badge badge-high">HIGH</span>
                    {% elif f.severity == 'MEDIUM' %}<span class="badge badge-medium">MEDIUM</span>
                    {% else %}<span class="badge badge-low">LOW</span>{% endif %}
                </td>
                <td class="mono">{{ "%.2f"|format(f.confidence) }}</td>
                <td>
                    {% for m in f.mitre %}
                    <span class="pill pill-mitre">{{ m }}</span>
                    {% endfor %}
                </td>
                <td class="mono">{{ f.process.name }} ({{ f.process.pid }})</td>
                <td><span class="badge badge-detected">DETECTED</span></td>
            </tr>
            {% endfor %}
        </table>

        {% if data.summary.verdict == 'DETECTED' %}
        <div class="callout callout-danger no-break">
            <div class="callout-title">&#9888; Composite Threat Assessment</div>
            Corroborated findings confirm the presence of structural anomalies within the examined scope. Memory artifacts reflect indicators requiring immediate isolation and detailed forensic analysis.
        </div>
        {% elif data.summary.verdict == 'NOT DETECTED' %}
        <div class="callout callout-info no-break" style="background: #F0FDF4; border-color: #22C55E; color: #15803D;">
            <div class="callout-title" style="color: #15803D;">&#10004; Composite Assessment &mdash; Clean Within Scope</div>
            No corroborated malware anomalies were detected within the executed detection modules. Note that unexamined areas (such as unexecuted hook or driver modules) were not evaluated and cannot be asserted clean.
        </div>
        {% elif data.summary.verdict == 'PARTIAL' %}
        <div class="callout callout-warning no-break" style="background: #FEF3C7; border-color: #F59E0B; color: #92400E;">
            <div class="callout-title" style="color: #92400E;">&#9888; Composite Assessment &mdash; Partial Coverage</div>
            Analysis completed with partial capability coverage. One or more required analytical views were unavailable. No conclusive assessment can be drawn regarding unexamined modules.
        </div>
        {% else %}
        <div class="callout callout-warning no-break" style="background: #FEF3C7; border-color: #F59E0B; color: #92400E;">
            <div class="callout-title" style="color: #92400E;">&#9888; Composite Assessment &mdash; Inconclusive / Insufficient Evidence</div>
            Analysis could not establish a definitive threat assessment. Requisite evidence, symbol resolution, or corroborated observations were insufficient to form a conclusive determination.
        </div>
        {% endif %}
    </div>

    <!-- ================================================================= -->
    <!-- PAGE 7 & 8: MEMORY FORENSICS APPENDIX (PROCESS TREE & ROOTKITS)    -->
    <!-- ================================================================= -->
    {% if data.evidence.is_memory_image %}
    <div class="page">
        <h1 class="section-title">
            <span>7. Process Lineage &amp; PPID Spoofing Analysis</span>
            {% if data.ppid_anomalies | length > 0 %}
            <span class="badge badge-high">{{ data.ppid_anomalies | length }} ANOMALIES DETECTED</span>
            {% else %}
            <span class="badge badge-clean">0 ANOMALIES DETECTED</span>
            {% endif %}
        </h1>

        <p style="margin-bottom: 8px;">
            Windows processes follow immutable parent-child hierarchy baselines. Advanced fileless malware exploits the Windows API (e.g., <code>UpdateProcThreadAttribute</code> with <code>PROC_THREAD_ATTRIBUTE_PARENT_PROCESS</code>) to spoof its parent process ID, making a malicious payload appear as if it was legitimately launched by a trusted service.
        </p>

        <!-- Compact Process Summary Table -->
        {% if data.process_summary %}
        <div class="kpi-row no-break" style="grid-template-columns: repeat(4, 1fr); margin-bottom: 8px;">
            <div class="kpi-card" style="padding: 5px;">
                <div class="kpi-num" style="font-size: 13pt; color: #2563EB;">{{ data.process_summary.total_processes }}</div>
                <div class="kpi-label">Audited Processes</div>
            </div>
            <div class="kpi-card" style="padding: 5px;">
                <div class="kpi-num" style="font-size: 13pt; color: var(--sev-critical);">{{ data.process_summary.anomalous_processes }}</div>
                <div class="kpi-label">Anomalous Processes</div>
            </div>
            <div class="kpi-card" style="padding: 5px;">
                <div class="kpi-num" style="font-size: 13pt; color: var(--sev-clean);">{{ data.process_summary.clean_processes }}</div>
                <div class="kpi-label">Verified Baselines</div>
            </div>
            <div class="kpi-card" style="padding: 5px;">
                <div class="kpi-num" style="font-size: 13pt; color: #475569;">{{ data.process_summary.system_daemons }}</div>
                <div class="kpi-label">System Daemons</div>
            </div>
        </div>
        {% endif %}

        <!-- Process Tree SVG Diagram -->
        <div class="no-break" style="margin-bottom: 12px; border: 1px solid #1E293B; border-radius: 6px; overflow: hidden;">
            {{ process_tree_svg | safe }}
        </div>

        <h2 class="sub-title">Detailed Process Hierarchy Anomalies</h2>
        <table class="report-table no-break">
            <tr>
                <th style="width: 20%;">Rule Triggered</th>
                <th style="width: 25%;">Observed Relationship</th>
                <th style="width: 25%;">Expected OS Baseline</th>
                <th style="width: 15%;">MITRE ATT&amp;CK</th>
                <th style="width: 15%;">Risk Level</th>
            </tr>
            {% for a in data.ppid_anomalies %}
            <tr>
                <td><strong>{{ a.rule }}</strong></td>
                <td style="color: var(--sev-critical); font-family: 'JetBrains Mono', monospace;">{{ a.observed }}</td>
                <td style="color: var(--sev-clean); font-family: 'JetBrains Mono', monospace;">{{ a.expected }}</td>
                <td><span class="pill pill-mitre">{{ a.mitre }}</span></td>
                <td><span class="badge badge-critical">{{ a.severity }}</span></td>
            </tr>
            {% endfor %}
            {% if not data.ppid_anomalies %}
            <tr>
                <td colspan="5" style="text-align: center; color: var(--sev-clean); font-weight: bold; padding: 10px;">
                    &#10004; Zero process hierarchy anomalies detected within examined execution ancestry.
                </td>
            </tr>
            {% endif %}
        </table>

        {% if data.ppid_anomalies %}
        <div class="callout callout-warning no-break">
            <div class="callout-title">&#128269; Forensic Analysis of Observed PPID Violations</div>
            Observed parent-process relationships violate standard operating system execution baselines, indicating potential process masquerading or PPID spoofing (MITRE T1134.004).
        </div>
        {% else %}
        <div class="callout callout-info no-break" style="background: #F0FDF4; border-color: #22C55E; color: #15803D;">
            <div class="callout-title" style="color: #15803D;">&#10004; Lineage Baseline Audit &mdash; No Discrepancies</div>
            All audited processes conformed to baseline parent-child execution hierarchies within the examined scope.
        </div>
        {% endif %}
    </div>

    <!-- PAGE 8: HIDDEN PROCESS & ROOTKIT DETECTION (DKOM) -->
    <div class="page">
        <h1 class="section-title">
            <span>8. Hidden Process &amp; Rootkit Detection</span>
            {% if data.hidden_processes | length > 0 %}
            <span class="badge badge-critical">{{ data.hidden_processes | length }} DISCREPANCIES DETECTED</span>
            {% else %}
            <span class="badge badge-clean">0 DISCREPANCIES</span>
            {% endif %}
        </h1>

        <p style="margin-bottom: 8px;">
            Sophisticated malware avoids detection by unlinking its <code>EPROCESS</code> block from the OS scheduler's doubly linked list (<code>ActiveProcessLinks</code>). While invisible to user-mode monitors like Task Manager and Volatility's <code>pslist</code>, its execution structures remain detectable in physical memory pool tags (<code>psscan</code>) and thread scheduler tables.
        </p>

        <h2 class="sub-title">Cross-View Comparison Matrix (DKOM Carving)</h2>
        <table class="report-table no-break">
            <tr>
                <th style="width: 55px; white-space: nowrap;">PID</th>
                <th style="width: 130px;">Process Name</th>
                <th>ActiveProcessLinks (pslist)</th>
                <th>Pool Carving (psscan)</th>
                <th>Thread Scan</th>
                <th>CSRSS Table</th>
                <th>PspCidTable</th>
                <th style="width: 105px;">Forensic Status</th>
            </tr>
            {% for hp in data.hidden_processes %}
            <tr>
                <td class="mono" style="font-weight: 700; white-space: nowrap;">{{ hp.pid }}</td>
                <td class="mono"><strong>{{ hp.name }}</strong></td>
                <td class="matrix-cell-fail">&#10006; MISSING</td>
                <td class="matrix-cell-pass">&#10004; PRESENT</td>
                <td class="matrix-cell-pass">&#10004; ACTIVE ({{ hp.threads }})</td>
                <td class="matrix-cell-fail">&#10006; UNLINKED</td>
                <td class="matrix-cell-pass">&#10004; PRESENT</td>
                <td><span class="badge badge-critical">DKOM ROOTKIT</span></td>
            </tr>
            {% endfor %}
            {% if not data.hidden_processes %}
            <tr>
                <td colspan="8" style="text-align: center; color: var(--sev-clean); font-weight: bold; padding: 10px;">
                    &#10004; Zero unlinked processes detected. Evaluated process entries match between active list and memory pool carving.
                </td>
            </tr>
            {% endif %}
        </table>

        <h2 class="sub-title">Kernel Integrity &amp; Hooking Audits</h2>
        <table class="report-table no-break">
            <tr>
                <th style="width: 25%;">Integrity Check</th>
                <th style="width: 15%;">Verdict</th>
                <th style="width: 45%;">Diagnostic Details</th>
                <th style="width: 15%;">MITRE ATT&amp;CK</th>
            </tr>
            {% for rk in data.rootkit_checks %}
            <tr>
                <td><strong>{{ rk.check }}</strong></td>
                <td>
                    {% if rk.verdict == 'DETECTED' %}<span class="badge badge-critical">DETECTED</span>
                    {% elif rk.verdict == 'CLEAN' or rk.verdict == 'NOT DETECTED' %}<span class="badge badge-clean">CLEAN</span>
                    {% elif rk.verdict == 'NOT_RUN' %}<span class="badge badge-unknown">NOT RUN</span>
                    {% else %}<span class="badge badge-unknown">UNKNOWN</span>{% endif %}
                </td>
                <td>{{ rk.details }}</td>
                <td><span class="pill pill-mitre">{{ rk.mitre }}</span></td>
            </tr>
            {% endfor %}
        </table>

        {% if data.hidden_processes %}
        <div class="callout callout-danger no-break">
            <div class="callout-title">&#9760; Technical Analysis of Direct Kernel Object Manipulation (DKOM)</div>
            The process <strong>{{ data.hidden_processes[0].name }}</strong> (PID: {{ data.hidden_processes[0].pid }}) exhibits unlinked DKOM execution characteristics. The process structure was carved from memory pools but was absent from the ActiveProcessLinks doubly linked list, concealing execution from user-mode monitors.
        </div>
        {% else %}
        <div class="callout callout-info no-break">
            <div class="callout-title">&#128737; Kernel Process Consistency Verified</div>
            Cross-referencing between active scheduling structures (<code>ActiveProcessLinks</code>) and memory pool tags confirmed zero unlinked process objects in evaluated memory.
        </div>
        {% endif %}
    </div>
    {% else %}
    <div class="page">
        <h1 class="section-title">
            <span>7. Process Lineage &amp; 8. Memory Forensics Appendix</span>
            <span class="badge badge-info">BYPASS (STATIC FILE)</span>
        </h1>
        <div class="callout callout-info no-break" style="margin-top: 14px;">
            <div class="callout-title">&#128737; Memory Forensics Appendix Bypassed for Static File</div>
            The ingested artifact was classified as <strong>{{ data.evidence.detected_type or 'Static File / Executable' }}</strong>. Volatile physical RAM structures (ActiveProcessLinks, Virtual Address Descriptors, thread scheduler tables, and DKOM rootkit pools) are applicable solely to raw memory images. Memory forensic inspection was accordingly bypassed in favor of static structural inspection and targeted YARA pattern matching.
        </div>
    </div>
    {% endif %}

    <!-- ================================================================= -->
    <!-- YARA SIGNATURE RULE MATCH SUMMARY                                 -->
    <!-- ================================================================= -->
    <div class="page">
        <h1 class="section-title">
            <span>9. YARA Signature Rule Matches</span>
            {% if data.yara_scans and data.yara_scans | length > 0 %}
            <span class="badge badge-critical">{{ data.yara_scans | length }} SIGNATURE HITS</span>
            {% else %}
            <span class="badge badge-clean">0 SIGNATURE HITS</span>
            {% endif %}
        </h1>
        <p style="margin-bottom: 8px;">
            YARA multi-engine pattern scanning was executed across extracted in-memory injections, shellcode candidates, and process command lines.
        </p>

        {% if data.yara_scans %}
        <table class="report-table no-break" style="margin-bottom: 12px;">
            <tr>
                <th style="width: 25%;">Rule Name</th>
                <th style="width: 20%;">Target / Context</th>
                <th style="width: 15%;">Target Type</th>
                <th style="width: 20%;">Matched Strings</th>
                <th style="width: 20%;">Severity</th>
            </tr>
            {% for y in data.yara_scans %}
            <tr>
                <td class="mono"><strong>{{ y.rule }}</strong></td>
                <td class="mono">{{ y.target }}</td>
                <td>{{ y.target_type }}</td>
                <td style="text-align: center;"><span class="badge badge-high">{{ y.matched_strings_count }} string(s)</span></td>
                <td>
                    {% if y.severity == 'CRITICAL' %}<span class="badge badge-critical">CRITICAL</span>
                    {% elif y.severity == 'HIGH' %}<span class="badge badge-high">HIGH</span>
                    {% else %}<span class="badge badge-medium">{{ y.severity }}</span>{% endif %}
                </td>
            </tr>
            {% endfor %}
        </table>

        <!-- Detailed Match Cards -->
        {% for y in data.yara_scans %}
        <div class="no-break" style="background: #F8FAFC; border: 1px solid var(--border-subtle); border-radius: 6px; padding: 10px; margin-bottom: 10px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                <span class="mono" style="font-weight: 800; font-size: 8.5pt; color: #1E293B;">RULE: {{ y.rule }}</span>
                <span class="badge {% if y.severity == 'CRITICAL' %}badge-critical{% else %}badge-high{% endif %}">{{ y.severity }}</span>
            </div>
            <div style="font-size: 7.5pt; margin-bottom: 6px; color: #334155;">{{ y.description }}</div>
            
            {% if y.matched_strings %}
            <div class="code-title" style="margin-top: 4px;">MATCHED STRINGS &amp; HEX OFFSETS</div>
            <table class="report-table" style="font-size: 6.5pt; margin-bottom: 6px;">
                <tr><th style="width: 20%;">Identifier</th><th style="width: 25%;">Hex Offset</th><th>Matched Data Preview</th></tr>
                {% for str_item in y.matched_strings %}
                <tr>
                    <td class="mono"><strong>{{ str_item.identifier }}</strong></td>
                    <td class="mono" style="color: #2563EB;">{{ str_item.offset }}</td>
                    <td class="mono" style="color: #059669; word-break: break-all;">{{ str_item.data }}</td>
                </tr>
                {% endfor %}
            </table>
            {% endif %}

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px; font-size: 7pt; margin-top: 6px;">
                <div style="background: #FFFFFF; border: 1px solid #E2E8F0; padding: 6px; border-radius: 4px;">
                    <strong style="color: #991B1B;">Why It Matters:</strong><br/>
                    {{ y.why_it_matters or 'Deterministic indicator of malicious payload pattern.' }}
                </div>
                <div style="background: #FFFFFF; border: 1px solid #E2E8F0; padding: 6px; border-radius: 4px;">
                    <strong style="color: #475569;">Scope &amp; False Positive Considerations:</strong><br/>
                    {{ y.false_positive_considerations or 'Administrative scripts or telemetry hooks may share common substrings.' }}
                </div>
            </div>
            {% if y.engine_info %}
            <div style="font-size: 6.5pt; color: #64748B; margin-top: 4px;">
                Engine: {{ y.engine_info.engine }} | Ruleset: {{ y.engine_info.ruleset_version }} | Scope: {{ y.engine_info.scan_scope }}
            </div>
            {% endif %}
        </div>
        {% endfor %}

        <div class="callout callout-warning no-break" style="margin-top: 6px;">
            <div class="callout-title">&#9888; YARA Signature Match Verification</div>
            Matched signatures provide deterministic proof of weaponized code constructs, known download cradles, or shellcode execution sequences in active process memory.
        </div>
        {% else %}
        <div class="callout callout-info no-break" style="background: #F0FDF4; border-color: #22C55E; color: #15803D; margin-top: 10px;">
            <div class="callout-title" style="color: #15803D;">&#10004; Zero Signature Matches (Clean Within Signature Scope)</div>
            The YARA multi-engine scanner executed across all extracted process command lines, image identities, and memory buffers. 0 signature hits were observed across active detection rulesets. This confirms the absence of known signature indicators within executed rules, distinct from an unexecuted or failed scan.
        </div>
        {% endif %}
    </div>

    <!-- ================================================================= -->
    <!-- PAGES 9-11: DETAILED FINDINGS                                     -->
    <!-- ================================================================= -->
    {% for f in data.findings %}
    <div class="page">
        <div class="finding-card">
            <!-- Header Strip -->
            <div class="finding-header">
                <div class="finding-header-left">
                    <span class="finding-id">{{ f.id }}</span>
                    <span class="finding-title">{{ f.title }}</span>
                </div>
                <div>
                    {% if f.severity == 'CRITICAL' %}<span class="badge badge-critical">CRITICAL</span>
                    {% elif f.severity == 'HIGH' %}<span class="badge badge-high">HIGH</span>
                    {% else %}<span class="badge badge-medium">MEDIUM</span>{% endif %}
                    <span class="badge badge-detected">TRIAGE SCORE: {{ "%.2f"|format(f.confidence) }}</span>
                </div>
            </div>

            <div class="finding-body">
                <div style="margin-bottom: 8px;">
                    {% for m in f.mitre %}
                    <span class="pill pill-mitre">{{ m }}</span>
                    {% endfor %}
                </div>

                <!-- 7-Facet Deterministic Detection Breakdown Table -->
                {% set de = f.detection_explanation if (f.detection_explanation is defined and f.detection_explanation) else {} %}
                <div class="no-break" style="margin-bottom: 10px; background: #FFFFFF; border: 1px solid var(--border-subtle); border-radius: 6px; padding: 8px;">
                    <div class="code-title" style="margin-bottom: 4px;">DETERMINISTIC 7-FACET FORENSIC EVALUATION</div>
                    <table class="report-table" style="font-size: 7pt; margin-bottom: 0;">
                        <tr><th style="width: 25%;">Forensic Facet</th><th>Analytical Determination</th></tr>
                        <tr><td><strong>1. What Was Observed</strong></td><td>{{ de.what_observed or f.what_observed or f.description }}</td></tr>
                        <tr><td><strong>2. Where Observed</strong></td><td class="mono">{{ de.where_observed or f.where_observed or (f.process.name ~ ' (PID: ' ~ f.process.pid ~ ')') }}</td></tr>
                        <tr><td><strong>3. Detecting Heuristic / Tool</strong></td><td>{{ de.detected_by or f.detected_by or 'Compy Deterministic Forensic Engine' }}</td></tr>
                        <tr><td><strong>4. Why It Matters</strong></td><td>{{ de.why_it_matters or f.why_it_matters or 'Indicates unauthorized execution or evasion activity.' }}</td></tr>
                        <tr><td><strong>5. Supporting Evidence</strong></td><td class="mono" style="font-size: 6.5pt;">{{ de.supporting_evidence or f.supporting_evidence or (f.iocs | string) }}</td></tr>
                        <tr><td><strong>6. Confidence &amp; Limitations</strong></td><td>{{ de.confidence_and_limitations or f.confidence_and_limitations or 'High confidence within evaluated scope; offline persistence not evaluated.' }}</td></tr>
                        <tr><td><strong>7. Recommended Next Step</strong></td><td style="color: #1E3A8A; font-weight: bold;">{{ de.next_step or f.next_step or (f.remediation[0] if (f.remediation is defined and f.remediation) else 'Isolate affected host and preserve volatile memory.') }}</td></tr>
                    </table>
                </div>

                <div class="layout-sidebar no-break">
                    <!-- Left Column: Narrative & Technical Details -->
                    <div>
                        <h3 class="micro-title">Finding Description</h3>
                        <p style="margin-bottom: 8px; font-size: 8pt;">
                            {{ f.description }}
                        </p>

                        <h3 class="micro-title">Target Process &amp; Memory Geometry</h3>
                        <table class="report-table" style="margin-bottom: 8px;">
                            <tr><th style="width: 35%;">Parameter</th><th>Forensic Value</th></tr>
                            <tr><td>Process Identity</td><td class="mono">{{ f.process.name }} (PID: {{ f.process.pid }}, PPID: {{ f.process.ppid }})</td></tr>
                            <tr><td>Security Context (User)</td><td class="mono">{{ f.process.user }}</td></tr>
                            <tr><td>Spawned Command Line</td><td class="mono" style="font-size: 6.5pt;">{{ f.process.cmdline or f.process.path }}</td></tr>
                            {% if f.memory_region %}
                            <tr><td>Memory Base Address</td><td class="mono" style="color: var(--sev-critical); font-weight: bold;">{{ f.memory_region.base_address }} (Size: {{ f.memory_region.size }})</td></tr>
                            <tr><td>Page Protection Flags</td><td class="mono"><strong>{{ f.memory_region.protection }}</strong></td></tr>
                            <tr><td>Backing Structure</td><td>{{ f.memory_region.backing }} (VAD Tag: {{ f.memory_region.vad_tag }})</td></tr>
                            <tr><td>Calculated Entropy</td><td class="mono">{{ f.memory_region.entropy }} (High Entropy / Encrypted)</td></tr>
                            {% endif %}
                        </table>

                        <h3 class="micro-title">Evidence Artifacts &amp; Disassembly</h3>
                        {% if f.artifacts and f.artifacts.hex_dump %}
                        <div class="code-title">HEX DUMP EXCERPT (VAD BASE)</div>
                        <div class="hex-dump-box">{{ f.artifacts.hex_dump }}</div>
                        {% endif %}

                        {% if f.artifacts and f.artifacts.disassembly %}
                        <div class="code-title">DISASSEMBLY SNIPPET</div>
                        <div class="hex-dump-box" style="color: #4ADE80;">{{ f.artifacts.disassembly }}</div>
                        {% endif %}

                        {% if f.artifacts and f.artifacts.decoded_script %}
                        <div class="code-title">DECODED PAYLOAD TRANSLATION</div>
                        <div class="hex-dump-box" style="color: #FCD34D;">{{ f.artifacts.decoded_script }}</div>
                        {% endif %}

                        {% if not f.artifacts or (not f.artifacts.hex_dump and not f.artifacts.disassembly and not f.artifacts.decoded_script) %}
                        <div style="font-size: 7.5pt; color: #64748B; font-style: italic; margin-top: 4px;">
                            No raw memory hex dump or disassembly associated with this finding (Lineage/DKOM structural evidence).
                        </div>
                        {% endif %}
                    </div>

                    <!-- Right Column: Sidebar IOCs, Attack Technique & Reasoning -->
                    <div>
                        <div class="callout callout-danger" style="margin-top: 0;">
                            <div class="callout-title">&#128308; Attack Technique Breakdown</div>
                            <p style="font-size: 7.5pt;">
                                {{ f.why_it_matters or 'The presence of unbacked PAGE_EXECUTE_READWRITE memory is an anomalous forensic indicator. Legitimate Windows software allocates code sections with PAGE_EXECUTE_READ. Read-Write-Execute permissions permit runtime shellcode self-decryption and dynamic reflective loading.' }}
                            </p>
                        </div>

                        <h3 class="micro-title">Specific Indicators of Compromise</h3>
                        <table class="report-table" style="font-size: 7pt; margin-bottom: 8px;">
                            <tr><th>Indicator</th><th>Value</th></tr>
                            {% for k, v in f.iocs.items() %}
                            <tr><td style="font-weight: 700;">{{ k }}</td><td class="mono" style="font-size: 6.5pt;">{{ v }}</td></tr>
                            {% endfor %}
                        </table>

                        <h3 class="micro-title">Deterministic Tri-State Reasoning Chain</h3>
                        <ul style="margin-left: 14px; font-size: 7.5pt; color: #334155;">
                            {% for step in f.reasoning %}
                            <li style="margin-bottom: 2px;">{{ step }}</li>
                            {% endfor %}
                        </ul>

                        <h3 class="micro-title" style="margin-top: 8px;">Recommended Remediation</h3>
                        <ul style="margin-left: 14px; font-size: 7.5pt; color: #1E3A8A;">
                            {% for rem in f.remediation %}
                            <li style="margin-bottom: 2px;">{{ rem }}</li>
                            {% endfor %}
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
    {% endfor %}

    <!-- ================================================================= -->
    <!-- PAGE 12: MITRE ATT&CK MATRIX & MAPPING                            -->
    <!-- ================================================================= -->
    <div class="page">
        <h1 class="section-title">
            <span>10. MITRE ATT&amp;CK Enterprise Mapping</span>
            <span class="badge badge-info">ATT&amp;CK v14</span>
        </h1>

        <p style="margin-bottom: 10px;">
            The matrix below maps identified memory artifacts to the standard MITRE ATT&amp;CK Framework tactics and techniques. Highlighted cells indicate techniques confirmed through physical memory indicators.
        </p>

        <!-- Matrix Grid -->
        <table class="report-table no-break" style="text-align: center; font-size: 6.5pt;">
            <tr>
                <th style="width: 14%;">Execution</th>
                <th style="width: 14%;">Persistence</th>
                <th style="width: 14%;">Privilege Escalation</th>
                <th style="width: 14%;">Defense Evasion</th>
                <th style="width: 14%;">Discovery</th>
                <th style="width: 14%;">Command &amp; Control</th>
                <th style="width: 16%;">Exfiltration</th>
            </tr>
            <tr>
                <td style="background: #FEE2E2; color: #991B1B; font-weight: bold;">T1059.001<br/>PowerShell</td>
                <td style="background: #FEE2E2; color: #991B1B; font-weight: bold;">T1547.001<br/>Registry Run Keys</td>
                <td style="background: #F1F5F9; color: #64748B;">T1068<br/>Exploitation</td>
                <td style="background: #FEE2E2; color: #991B1B; font-weight: bold;">T1055.012<br/>Process Hollowing</td>
                <td style="background: #F1F5F9; color: #64748B;">T1057<br/>Process Discovery</td>
                <td style="background: #FEE2E2; color: #991B1B; font-weight: bold;">T1071.001<br/>Web Protocols</td>
                <td style="background: #F1F5F9; color: #64748B;">T1041<br/>C2 Channel</td>
            </tr>
            <tr>
                <td style="background: #F1F5F9; color: #64748B;">T1204.002<br/>Malicious File</td>
                <td style="background: #F1F5F9; color: #64748B;">T1053<br/>Scheduled Task</td>
                <td style="background: #FEE2E2; color: #991B1B; font-weight: bold;">T1134.004<br/>PPID Spoofing</td>
                <td style="background: #FEE2E2; color: #991B1B; font-weight: bold;">T1014<br/>Rootkit (DKOM)</td>
                <td style="background: #F1F5F9; color: #64748B;">T1082<br/>System Info</td>
                <td style="background: #FEE2E2; color: #991B1B; font-weight: bold;">T1573<br/>Encrypted C2</td>
                <td style="background: #F1F5F9; color: #64748B;">T1020<br/>Automated Exfil</td>
            </tr>
        </table>

        <h2 class="sub-title">Technique Evidence Reference Table</h2>
        <table class="report-table no-break">
            <tr>
                <th style="width: 15%;">Tactic</th>
                <th style="width: 15%;">Technique ID</th>
                <th style="width: 25%;">Technique Name</th>
                <th style="width: 15%;">Finding Ref</th>
                <th style="width: 30%;">Forensic Corroboration</th>
            </tr>
            {% for m in data.mitre_mapping %}
            <tr>
                <td>{{ m.tactic }}</td>
                <td class="mono"><strong>{{ m.technique_id }}</strong></td>
                <td>{{ m.technique_name }}</td>
                <td class="mono" style="color: #2563EB;">{{ m.finding_ref }}</td>
                <td>{{ m.evidence }}</td>
            </tr>
            {% endfor %}
        </table>
    </div>

    <!-- ================================================================= -->
    <!-- PAGE 13: CONSOLIDATED IOC APPENDIX & ATTACK TIMELINE              -->
    <!-- ================================================================= -->
    <div class="page">
        <h1 class="section-title">
            <span>11. Indicators of Compromise &amp; 12. Attack Chronology</span>
            <span class="badge badge-info">EVIDENCE APPENDIX</span>
        </h1>

        <h2 class="sub-title">11. Consolidated Indicators of Compromise (IOCs)</h2>
        <div class="layout-2col no-break">
            <div>
                <h3 class="micro-title">Cryptographic File Hashes</h3>
                <table class="report-table">
                    <tr><th>Type</th><th>Hash Value</th></tr>
                    <tr><td>SHA-256 (Image)</td><td class="mono">{{ data.evidence.sha256[:32] }}...</td></tr>
                    {% if data.consolidated_iocs and data.consolidated_iocs.hashes %}
                    {% for h in data.consolidated_iocs.hashes %}
                    <tr><td>{{ h.type }}</td><td class="mono">{{ h.value }}</td></tr>
                    {% endfor %}
                    {% else %}
                    <tr><td colspan="2" style="color: #64748B; font-style: italic;">No secondary payload hashes extracted.</td></tr>
                    {% endif %}
                </table>

                <h3 class="micro-title">Network Communication Endpoints</h3>
                <table class="report-table">
                    <tr><th>Type</th><th>Destination</th><th>Port</th></tr>
                    {% if data.consolidated_iocs and data.consolidated_iocs.network %}
                    {% for net in data.consolidated_iocs.network %}
                    <tr><td>{{ net.type }}</td><td class="mono">{{ net.indicator }}</td><td>{{ net.port or 'N/A' }}</td></tr>
                    {% endfor %}
                    {% else %}
                    <tr><td colspan="3" style="color: #64748B; font-style: italic;">No network indicators extracted from evidence.</td></tr>
                    {% endif %}
                </table>
            </div>

            <div>
                <h3 class="micro-title">Host &amp; Named Pipe Artifacts</h3>
                <table class="report-table">
                    <tr><th>Artifact Category</th><th>Value / Key Path</th></tr>
                    {% if data.consolidated_iocs and data.consolidated_iocs.host_artifacts %}
                    {% for art in data.consolidated_iocs.host_artifacts %}
                    <tr><td>{{ art.category }}</td><td class="mono">{{ art.value }}</td></tr>
                    {% endfor %}
                    {% else %}
                    <tr><td colspan="2" style="color: #64748B; font-style: italic;">No host/pipe artifacts extracted from evidence.</td></tr>
                    {% endif %}
                </table>
            </div>
        </div>

        <h2 class="sub-title">12. Attack Chronology &amp; Incident Reconstruction Timeline</h2>
        <table class="report-table no-break">
            <tr>
                <th style="width: 20%;">Timestamp (UTC)</th>
                <th style="width: 15%;">Source</th>
                <th style="width: 25%;">Forensic Event</th>
                <th style="width: 25%;">Entity Impacted</th>
                <th style="width: 15%;">Severity</th>
            </tr>
            {% for ev in data.timeline %}
            <tr>
                <td class="mono">{{ ev.timestamp_utc }}</td>
                <td>{{ ev.source }}</td>
                <td><strong>{{ ev.action }}</strong></td>
                <td class="mono">{{ ev.entity }}</td>
                <td>
                    {% if ev.severity == 'CRITICAL' %}<span class="badge badge-critical">CRITICAL</span>
                    {% elif ev.severity == 'HIGH' %}<span class="badge badge-high">HIGH</span>
                    {% else %}<span class="badge badge-info">INFO</span>{% endif %}
                </td>
            </tr>
            {% endfor %}
        </table>
    </div>

    <!-- ================================================================= -->
    <!-- PAGE 14: RISK SCORING METHODOLOGY & RECOMMENDATIONS               -->
    <!-- ================================================================= -->
    <div class="page">
        <h1 class="section-title">
            <span>13. Risk Scoring &amp; 14. Action Plan</span>
            <span class="badge badge-info">METHODOLOGY</span>
        </h1>

        <h2 class="sub-title">13. Risk Scoring Mathematical Model</h2>
        <p style="margin-bottom: 6px;">
            The Composite Risk Score ($R \in [0, 100]$) is computed using a weighted multi-factor heuristic evaluated across every corroborated finding:
        </p>

        <div class="callout callout-info no-break" style="font-family: 'JetBrains Mono', monospace; font-size: 7.5pt;">
            Risk = &Sigma; [ (Severity_Weight &times; Triage_Score) + (Persistence &times; 15) + (Stealth_DKOM &times; 15) + (Privilege_Context &times; 10) ]
        </div>

        <table class="report-table no-break">
            <tr>
                <th>Factor</th>
                <th>Weight (%)</th>
                <th>Evaluation Criteria</th>
                <th>Observed Case Score</th>
            </tr>
            <tr><td>Finding Severity</td><td>35%</td><td>Critical (1.0), High (0.8), Medium (0.5), Low (0.2)</td><td>1.0 (Critical Present)</td></tr>
            <tr><td>Heuristic Corroboration</td><td>25%</td><td>Multi-engine corroboration and VAD tag confirmation</td><td>0.96 (Triage Weight)</td></tr>
            <tr><td>Stealth / Rootkit Mechanism</td><td>15%</td><td>DKOM unlinking, unbacked memory, PPID spoofing</td><td>1.0 (Active Evasion)</td></tr>
            <tr><td>Persistence Vector</td><td>15%</td><td>Registry Run keys, WMI event subscriptions</td><td>0.8 (Registry Hooked)</td></tr>
            <tr><td>Execution Privilege</td><td>10%</td><td>NT AUTHORITY\SYSTEM vs Standard User execution</td><td>1.0 (SYSTEM Access)</td></tr>
            <tr style="background: #F1F5F9; font-weight: bold;"><td colspan="3">CALCULATED COMPOSITE FORENSIC RISK SCORE:</td><td style="color: var(--sev-critical); font-size: 9pt;">{{ data.summary.risk_score }} / 100</td></tr>
        </table>

        <h2 class="sub-title">14. Prioritized Remediation Action Plan</h2>
        <table class="report-table no-break">
            <tr>
                <th style="width: 15%;">Phase</th>
                <th style="width: 45%;">Remediation Action Item</th>
                <th style="width: 15%;">Owner</th>
                <th style="width: 10%;">Effort</th>
                <th style="width: 15%;">Regulatory Impact</th>
            </tr>
            {% for rec in data.recommendations %}
            <tr>
                <td>
                    {% if 'Immediate' in rec.phase %}<span class="badge badge-critical">{{ rec.phase }}</span>
                    {% elif 'Short' in rec.phase %}<span class="badge badge-high">{{ rec.phase }}</span>
                    {% else %}<span class="badge badge-info">{{ rec.phase }}</span>{% endif %}
                </td>
                <td><strong>{{ rec.action }}</strong></td>
                <td>{{ rec.owner }}</td>
                <td>{{ rec.effort }}</td>
                <td>{{ rec.regulatory_impact }}</td>
            </tr>
            {% endfor %}
        </table>

        {% if data.mitigation_guidance %}
        <h2 class="sub-title" style="margin-top: 14px;">Evidence-Linked Response &amp; Containment Guidance</h2>
        <table class="report-table no-break">
            <tr>
                <th style="width: 12%;">Priority</th>
                <th style="width: 14%;">Action Type</th>
                <th style="width: 24%;">Associated Finding</th>
                <th style="width: 32%;">Recommended Action</th>
                <th style="width: 8%;">Auth</th>
                <th style="width: 10%;">Target ID</th>
            </tr>
            {% for mg in data.mitigation_guidance %}
            <tr>
                <td>
                    {% if mg.priority == 'CRITICAL' %}<span class="badge badge-critical">CRITICAL</span>
                    {% elif mg.priority == 'HIGH' %}<span class="badge badge-high">HIGH</span>
                    {% elif mg.priority == 'MEDIUM' %}<span class="badge badge-medium">MEDIUM</span>
                    {% else %}<span class="badge badge-info">{{ mg.priority }}</span>{% endif %}
                </td>
                <td><span class="pill pill-mitre">{{ mg.action_type }}</span></td>
                <td><strong>{{ mg.finding_title }}</strong></td>
                <td>{{ mg.recommended_action }}</td>
                <td style="text-align: center;">
                    {% if mg.human_authorization_required %}
                    <span class="badge badge-critical" style="font-size: 6pt;">REQUIRED</span>
                    {% else %}
                    <span class="badge badge-clean" style="font-size: 6pt;">AUTO</span>
                    {% endif %}
                </td>
                <td class="mono" style="font-size: 6.5pt;">{{ mg.target_evidence_id }}</td>
            </tr>
            {% endfor %}
        </table>
        {% endif %}
    </div>

    <!-- ================================================================= -->
    <!-- PAGE 15: LIMITATIONS & CANDIDATE WORKSHEET                        -->
    <!-- ================================================================= -->
    <div class="page">
        <h1 class="section-title">
            <span>15. Limitations &amp; Candidate Worksheet</span>
            <span class="badge badge-unknown">ANALYST AUDIT</span>
        </h1>

        <h2 class="sub-title">Assumptions &amp; Forensics Acquisition Constraints</h2>
        <ul style="margin-left: 14px; margin-bottom: 12px; font-size: 8pt;">
            {% for lim in data.limitations %}
            <li style="margin-bottom: 4px;">{{ lim }}</li>
            {% endfor %}
        </ul>

        <div class="callout callout-unknown no-break">
            <div class="callout-title">&#9888; Procedural Requirement for UNKNOWN Findings</div>
            When candidate hypotheses lack corroborating thread execution proof or have unresolvable PDB symbols, they are placed on the Analyst Verification Worksheet below. <strong>Per CERT-In and judicial guidelines, unresolved hypotheses must never be certified as Clean until physical disk/EDR correlation is performed.</strong>
        </div>

        <h2 class="sub-title">Candidate Verification Worksheet (Unresolved Candidates)</h2>
        {% if data.candidate_worksheet %}
        {% for cand in data.candidate_worksheet %}
        <div class="no-break" style="border: 1px solid #CBD5E1; border-radius: 4px; padding: 8px; margin-bottom: 8px; background: #FFFBEB;">
            <div style="display: flex; justify-content: space-between; margin-bottom: 4px;">
                <span style="font-weight: bold; color: #92400E; font-family: 'JetBrains Mono', monospace;">CANDIDATE ID: {{ cand.candidate_id }}</span>
                <span class="badge badge-unknown">UNRESOLVED HYPOTHESIS</span>
            </div>
            <div style="font-size: 7.5pt; margin-bottom: 4px;"><strong>Hypothesis:</strong> {{ cand.hypothesis }}</div>
            <div style="font-size: 7.5pt; margin-bottom: 4px; color: #B45309;"><strong>Reason Unresolved:</strong> {{ cand.unresolved_reason }}</div>
            <div style="font-size: 7.5pt; margin-bottom: 6px;"><strong>Required External Telemetry:</strong> {{ cand.required_evidence }}</div>
            
            <div style="font-size: 7pt; font-weight: bold; color: #78350F; margin-bottom: 2px;">ANALYST RESOLUTION CHECKLIST:</div>
            {% for chk in cand.checklist %}
            <div style="font-size: 7pt; color: #451A03;"><input type="checkbox"/> [ ] {{ chk }}</div>
            {% endfor %}
        </div>
        {% endfor %}
        {% else %}
        <p style="font-size: 8pt; color: var(--sev-clean); font-weight: bold;">
            [PASS] All detected candidates were deterministically verified. No unresolved UNKNOWN candidates remain.
        </p>
        {% endif %}
    </div>

    <!-- ================================================================= -->
    <!-- PAGE 16: CHAIN OF CUSTODY & EVIDENCE LEDGER                       -->
    <!-- ================================================================= -->
    <div class="page">
        <h1 class="section-title">
            <span>16. Pipeline Custody &amp; Report Integrity Seal</span>
            {% if data.report_integrity_seal_status and data.report_integrity_seal_status.is_verified %}
            <span class="badge badge-clean">{{ data.report_integrity_seal_status.label }}</span>
            {% elif data.report_integrity_seal_status and data.report_integrity_seal_status.status == 'INVALID' %}
            <span class="badge badge-critical">{{ data.report_integrity_seal_status.label }}</span>
            {% else %}
            <span class="badge badge-unknown">SEAL: UNVERIFIED / GENERATED</span>
            {% endif %}
        </h1>

        <h2 class="sub-title">Automated Analysis Pipeline Custody &amp; Transfer Log</h2>
        <p style="font-size: 7.5pt; color: #64748B; margin-bottom: 6px;">
            Note: This table records automated evidence ingest and transfer milestones within the software pipeline. It does not replace physical chain of custody documentation or statutory property seizure forms.
        </p>
        <table class="report-table no-break">
            <tr>
                <th style="width: 8%;">Item #</th>
                <th style="width: 25%;">Transferred From</th>
                <th style="width: 25%;">Transferred To</th>
                <th style="width: 20%;">Date &amp; Time (UTC)</th>
                <th style="width: 15%;">Purpose</th>
                <th style="width: 7%;">Hash Match</th>
            </tr>
            {% for c in data.custody %}
            <tr>
                <td>{{ c.item_num }}</td>
                <td>{{ c.transferred_from }}</td>
                <td>{{ c.transferred_to }}</td>
                <td class="mono">{{ c.timestamp_utc }}</td>
                <td>{{ c.purpose }}</td>
                <td style="color: var(--sev-clean); font-weight: bold; text-align: center;">&#10004; YES</td>
            </tr>
            {% endfor %}
        </table>

        <h2 class="sub-title">Report Integrity Seal (Cryptographic Metadata Chain)</h2>
        <p style="font-size: 7.5pt; color: #64748B; margin-bottom: 6px;">
            This seal represents a document-level cryptographic SHA-256 hash sequence computed across report generation metadata (evidence hash, investigation ID, verdict, and compilation state). It binds the compiled findings to prevent post-generation tampering. It does not replace the domain Evidence Ledger or independently verify physical evidence acquisition authenticity.
        </p>
        <table class="report-table no-break">
            <tr>
                <th style="width: 6%;">#</th>
                <th style="width: 18%;">Timestamp (UTC)</th>
                <th style="width: 24%;">Sealed Milestone / Action</th>
                <th style="width: 26%;">Current Block Hash (SHA-256)</th>
                <th style="width: 26%;">Previous Block Hash</th>
            </tr>
            {% for l in data.ledger %}
            <tr>
                <td style="font-weight: bold;">{{ l.n }}</td>
                <td class="mono">{{ l.ts }}</td>
                <td>{{ l.action }}</td>
                <td class="mono" style="font-size: 6pt; color: #2563EB;">{{ l.hash[:24] }}...</td>
                <td class="mono" style="font-size: 6pt; color: #64748B;">{{ l.prev_hash[:24] }}...</td>
            </tr>
            {% endfor %}
        </table>

        <div class="callout callout-info no-break" style="display: flex; align-items: center; justify-content: space-between;">
            <div>
                <div class="callout-title" style="color: var(--sev-clean);">&#128274; Report Integrity Seal Verification</div>
                <div>Each seal entry cryptographically binds the canonical payload to the preceding state hash (covering index, timestamp, evidence SHA-256, filename, investigation ID, verdict, and compilation findings count). This validates that report artifact metadata has not been altered post-compilation. Note: As a self-contained hash chain, this detects tampering but does not substitute for an asymmetric digital signature or physical chain-of-custody documentation.</div>
            </div>
            {% if data.report_integrity_seal_status and data.report_integrity_seal_status.is_verified %}
            <div style="padding: 4px 10px; background: #DCFCE7; border: 1px solid #86EFAC; border-radius: 4px; font-weight: 800; font-size: 7.5pt; color: #166534; white-space: nowrap;">
                &#10004; METADATA SEAL CRYPTOGRAPHICALLY VERIFIED
            </div>
            {% elif data.report_integrity_seal_status and data.report_integrity_seal_status.status == 'INVALID' %}
            <div style="padding: 4px 10px; background: #FEE2E2; border: 1px solid #FCA5A5; border-radius: 4px; font-weight: 800; font-size: 7.5pt; color: #991B1B; white-space: nowrap;">
                &#10006; SEAL INTEGRITY VERIFICATION FAILED
            </div>
            {% else %}
            <div style="padding: 4px 10px; background: #F1F5F9; border: 1px solid #CBD5E1; border-radius: 4px; font-weight: 800; font-size: 7.5pt; color: #475569; white-space: nowrap;">
                &#9888; SEAL GENERATED &mdash; VERIFICATION PENDING
            </div>
            {% endif %}
        </div>
    </div>

    <!-- ================================================================= -->
    <!-- PAGE 17: GLOSSARY OF DIGITAL FORENSICS TERMS                      -->
    <!-- ================================================================= -->
    <div class="page">
        <h1 class="section-title">
            <span>17. Digital Forensics Reference Glossary</span>
            <span class="badge badge-info">LEGAL &amp; TECHNICAL</span>
        </h1>

        <div class="layout-2col no-break" style="font-size: 7.5pt;">
            <div>
                <p><strong>Fileless Malware:</strong> Malicious software that operates entirely within volatile computer memory (RAM) or native OS scripting interpreters, without storing permanent binary files on the hard drive.</p>
                <hr style="border: 0; border-top: 1px dotted #CBD5E1; margin: 6px 0;"/>

                <p><strong>VAD (Virtual Address Descriptor):</strong> A self-balancing binary tree structure utilized by the Windows memory manager to track memory allocation and protection states for every process.</p>
                <hr style="border: 0; border-top: 1px dotted #CBD5E1; margin: 6px 0;"/>

                <p><strong>DKOM (Direct Kernel Object Manipulation):</strong> A sophisticated rootkit technique where malware directly modifies kernel memory objects (such as unlinking an EPROCESS from <code>ActiveProcessLinks</code>) to conceal its execution.</p>
                <hr style="border: 0; border-top: 1px dotted #CBD5E1; margin: 6px 0;"/>

                <p><strong>Process Hollowing:</strong> A code injection method where an attacker spawns a legitimate process in a suspended state, hollows out its legitimate memory sections, and replaces them with an encrypted malicious payload.</p>
                <hr style="border: 0; border-top: 1px dotted #CBD5E1; margin: 6px 0;"/>

                <p><strong>PAGE_EXECUTE_READWRITE (RWX):</strong> A memory page permission granting simultaneous write and execution rights. High-fidelity forensic indicator of shellcode unpacking and self-modifying code.</p>
            </div>

            <div>
                <p><strong>PPID Spoofing:</strong> The manipulation of a newly created process's parent process metadata to make it appear as an illegitimate child of a trusted Windows daemon (e.g., spoolsv.exe or services.exe).</p>
                <hr style="border: 0; border-top: 1px dotted #CBD5E1; margin: 6px 0;"/>

                <p><strong>Reflective DLL Injection:</strong> A technique whereby a dynamic link library is injected into a target process's memory space directly from volatile memory buffers, completely bypassing the Windows operating system loader.</p>
                <hr style="border: 0; border-top: 1px dotted #CBD5E1; margin: 6px 0;"/>

                <p><strong>Memory Smear:</strong> Inconsistencies introduced during physical RAM acquisition due to running CPU threads modifying memory pages while the imaging tool is reading them.</p>
                <hr style="border: 0; border-top: 1px dotted #CBD5E1; margin: 6px 0;"/>

                <p><strong>Tri-State Forensic Logic:</strong> Deterministic three-valued logic system (TRUE / FALSE / UNKNOWN) ensuring that forensic conclusions distinguish between verified absence of malware and lack of investigative telemetry.</p>
                <hr style="border: 0; border-top: 1px dotted #CBD5E1; margin: 6px 0;"/>

                <p><strong>Statutory Certification / Legal Admissibility:</strong> Formal certification under relevant jurisdiction rules (e.g., Section 65B, FRE 902) requiring execution by qualified personnel certifying acquisition provenance, tool validation, and evidence integrity.</p>
            </div>
        </div>
    </div>

    <!-- ================================================================= -->
    <!-- PAGE 18: TECHNICAL FINDINGS DECLARATION & EXAMINER ATTESTATION    -->
    <!-- ================================================================= -->
    <div class="page">
        <h1 class="section-title">
            <span>18. Technical Findings Declaration &amp; Evidentiary Disclaimer</span>
            <span class="badge badge-info">TECHNICAL DECLARATION</span>
        </h1>

        <!-- Technical Evidentiary Assessment -->
        <h2 class="sub-title">Technical Evidentiary Assessment</h2>
        {% if data.case.is_synthetic_demo %}
        <div class="callout callout-warning no-break" style="margin-bottom: 12px; background: #FEF3C7; border-color: #F59E0B; color: #92400E;">
            <div class="callout-title">&#9888; DEMONSTRATION NOTICE &mdash; NOT LEGAL EVIDENCE</div>
            This document was generated using synthetic demonstration fixtures. It does not reflect analysis of a physical memory image and is not admissible in court.
        </div>
        <p style="font-size: 8pt; margin-bottom: 12px; text-align: justify;">
            <strong>[SYNTHETIC DEMONSTRATION]</strong> Based upon synthetic memory structures and simulated analysis pipelines, the demonstration pipeline registered simulated verdict: <code>{{ data.summary.verdict }}</code>. This output is generated strictly for interface verification and pipeline testing. No actual host compromise or cleanliness is evaluated.
        </p>
        {% elif data.summary.verdict == 'DETECTED' %}
        <p style="font-size: 8pt; margin-bottom: 12px; text-align: justify;">
            Based upon deterministic algorithmic parsing, cross-view kernel structure corroboration, and cryptographic integrity verification performed upon the volatile memory image <code>{{ data.evidence.filename }}</code> (SHA-256: <code>{{ data.evidence.sha256 }}</code>), the automated analysis identified forensic anomalies consistent with in-memory or evasion activity within the executed capability scope ({{ data.coverage.modules_run }} module(s) evaluated). Supported findings include: {% if data.ppid_anomalies %}{{ data.ppid_anomalies|length }} process lineage/PPID anomaly(ies){% endif %}{% if data.ppid_anomalies and data.hidden_processes %}, and {% endif %}{% if data.hidden_processes %}{{ data.hidden_processes|length }} cross-view process discrepancy(ies){% endif %}{% if not data.ppid_anomalies and not data.hidden_processes %}in-memory execution anomalies documented in the findings ledger{% endif %}. This technical assessment is strictly limited to the examined memory structures and capability checks executed during this analysis run.
        </p>
        {% elif data.summary.verdict == 'NOT DETECTED' %}
        <p style="font-size: 8pt; margin-bottom: 12px; text-align: justify;">
            Based upon deterministic algorithmic parsing, cross-view kernel structure corroboration, and cryptographic integrity verification performed upon the volatile memory image <code>{{ data.evidence.filename }}</code> (SHA-256: <code>{{ data.evidence.sha256 }}</code>), no malicious indicators or structural discrepancies were detected by the {{ data.coverage.modules_run }} check(s) that actually executed. This finding confirms only that no anomalies were identified within the evaluated subsystems and capabilities; it does not claim or imply that the subject system is universally clean or free from threats in unexamined areas or unexecuted capabilities.
        </p>
        {% elif data.summary.verdict in ['UNKNOWN', 'INCONCLUSIVE'] %}
        <p style="font-size: 8pt; margin-bottom: 12px; text-align: justify;">
            Forensic evaluation of volatile memory image <code>{{ data.evidence.filename }}</code> (SHA-256: <code>{{ data.evidence.sha256 }}</code>) produced an inconclusive outcome (verdict: <code>{{ data.summary.verdict }}</code>). The available memory evidence, symbol definitions, or structural records are insufficient to formulate a definitive finding within the evaluated scope. Further corroboration, symbol acquisition, or supplementary forensic artifact collection is required before an authoritative conclusion can be drawn.
        </p>
        {% elif data.summary.verdict == 'PARTIAL' %}
        <p style="font-size: 8pt; margin-bottom: 12px; text-align: justify;">
            Forensic analysis of volatile memory image <code>{{ data.evidence.filename }}</code> (SHA-256: <code>{{ data.evidence.sha256 }}</code>) was only partially completed. Only {{ data.coverage.modules_run }} capability module(s) completed execution, while remaining capability checks were unexecuted or unavailable. This execution gap limits interpretation of the evidence, and no definitive determination of overall system state or compromise can be established from this partial record.
        </p>
        {% elif data.summary.verdict in ['FAILED', 'UNAVAILABLE'] %}
        <p style="font-size: 8pt; margin-bottom: 12px; text-align: justify;">
            Automated forensic analysis of volatile memory image <code>{{ data.evidence.filename }}</code> (SHA-256: <code>{{ data.evidence.sha256 }}</code>) could not be completed due to execution failure or capability unavailability. This report documents an incomplete execution; it does not constitute a completed forensic examination, and no inferences regarding compromise or system integrity can be supported.
        </p>
        {% else %}
        <p style="font-size: 8pt; margin-bottom: 12px; text-align: justify;">
            Automated forensic examination of memory image <code>{{ data.evidence.filename }}</code> (SHA-256: <code>{{ data.evidence.sha256 }}</code>) did not produce a finalized determination. Technical findings remain indeterminate and cannot support a conclusive determination.
        </p>
        {% endif %}

        <!-- Evidentiary Disclaimer & Execution Statement -->
        <div class="callout callout-info no-break" style="margin-bottom: 12px;">
            <div class="callout-title">&#128737; Software Output Disclaimer &amp; Legal Admissibility Notice</div>
            This document represents automated technical reasoning generated by forensic software operating upon the ingested memory artifact. The software does not establish legal admissibility, prove physical acquisition provenance, or independently satisfy statutory chain of custody requirements. Formal legal admissibility (such as under Section 65B/45 of the Indian Evidence Act, Federal Rule of Evidence 902, or equivalent jurisdictional standards) requires physical acquisition verification and attestation by authorized human forensic personnel.
        </div>

        {% if data.case.statutory_declaration %}
        <h2 class="sub-title">Operator Statutory Declaration</h2>
        <p style="font-size: 7.5pt; line-height: 1.4; margin-bottom: 8px; text-align: justify;">
            The following statutory declaration was supplied by the authorizing operator:
        </p>
        <div style="background: #F8FAFC; border: 1px solid var(--border-subtle); padding: 8px; font-size: 7.5pt; margin-bottom: 10px;">
            {{ data.case.statutory_declaration }}
        </div>
        {% else %}
        <p style="font-size: 7.5pt; line-height: 1.4; margin-bottom: 8px; text-align: justify;">
            <strong>Automated Generation Attestation:</strong>
        </p>
        <ol style="margin-left: 16px; font-size: 7.5pt; line-height: 1.35; margin-bottom: 8px;">
            <li>This report was compiled deterministically by <strong>{{ data.engine.name }}</strong> (Version {{ data.engine.version }}) from evidence structures extracted during automated execution.</li>
            <li>The source digital evidence file (<strong>{{ data.evidence.filename }}</strong>) was cryptographically registered with SHA-256 hash <code>{{ data.evidence.sha256 }}</code>.</li>
            <li>Observed findings reflect the specific detection modules executed during the analysis session. Unexecuted capabilities remain unassessed.</li>
        </ol>
        {% endif %}

        {% if data.case.examiner_signature_required or (data.case.examiner.name != 'Forensic Analyst' and data.case.examiner.name != 'Demo Analyst') %}
        <div class="layout-sidebar" style="margin-top: 10px; align-items: flex-end;">
            <div>
                <div style="font-size: 7.5pt; font-weight: bold; margin-bottom: 2px;">OPERATOR / EXAMINER ATTESTATION:</div>
                <div style="font-size: 7.5pt;">Name: {{ data.case.examiner.name }}</div>
                <div style="font-size: 7.5pt;">Designation: {{ data.case.examiner.designation }}</div>
                <div style="font-size: 7.5pt;">Organization / Lab: {{ data.case.examiner.agency }}</div>
                <div style="font-size: 7.5pt;">Date: {{ data.case.report_ts_ist }}</div>
                
                <div class="signature-box" style="margin-top: 6px;">
                    [ SIGNATURE OF REVIEWING ANALYST ]
                </div>
            </div>

            <div style="display: flex; flex-direction: column; align-items: center; justify-content: center;">
                <div class="stamp-box">
                    LAB / ENTITY<br/>STAMP
                </div>
            </div>
        </div>
        {% else %}
        <div style="margin-top: 12px; padding: 8px; background: #F8FAFC; border: 1px solid var(--border-subtle); border-radius: 4px; font-size: 7pt; color: #64748B;">
            <strong>REPORT ATTESTATION STATUS:</strong> Automated Software Generation. No human operator credentials, statutory declarations, or judicial distribution details were supplied for this run. To certify this report for judicial production, an authorized forensic examiner must review the underlying evidence and execute formal jurisdiction-appropriate declarations.
        </div>
        {% endif %}
    </div>
    </div>

</body>
</html>
